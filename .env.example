# Copy to .env and fill in your own values. Never commit the real file.
# Only the names are listed here. Every key is optional: a feature whose key is
# missing simply reports that it is not configured.

# Main language model (free tier) and its automatic backup
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Owner access code (unlocks owner-only settings and tools)
APEX_ACCESS_TOKEN=

# Sign-in and shared guest allowance (Firebase)
FIREBASE_PUBLIC_CONFIG=
FIREBASE_SERVICE_ACCOUNT_JSON=
APEX_GUEST_ENABLED=
APEX_GUEST_SECRET=
APEX_AUTH_PROVIDERS=
APEX_AUTH_EMAIL_READY=

# Plugins (free tiers)
TAVILY_API_KEY=
GNEWS_API_KEY=
TMDB_API_KEY=
YOUTUBE_API_KEY=
NASA_API_KEY=
PIXABAY_API_KEY=
ELEVENLABS_API_KEY=
